# PostgreSQL connection string used by the application and Prisma.
DATABASE_URL="postgresql://ims:change_me@localhost:5433/installation_manager?schema=public"

# Separate database used ONLY by the automated integration tests (it is wiped between tests).
TEST_DATABASE_URL="postgresql://ims:change_me@localhost:5433/installation_manager_test?schema=public"

# Public base URL of the app. Used to build password set/reset links shown to admins.
APP_URL="http://localhost:3000"

# Session lifetime in hours (default 12).
SESSION_TTL_HOURS="12"

# Password for the accounts created by `npm run db:seed` (development only).
SEED_PASSWORD="ChangeMe123!"

# Development only: other hostnames (comma separated) allowed to open the dev server, e.g. the
# machine's network IP. Without it, pages opened that way load without their scripts.
# ALLOWED_DEV_ORIGINS="192.168.1.20"

# Folder for visit photos, signatures and payment proofs (default: ./storage/uploads). Keep it
# outside the public folder and back it up together with the database.
# UPLOAD_DIR="D:\ims-uploads"
# Largest accepted upload in megabytes (default 8). Photos are shrunk in the browser first.
# MAX_UPLOAD_MB="8"

# Sign-in protection and request limits (all optional; see docs/AUTH_AND_REQUEST_SECURITY.md).
# Number of reverse proxies in front of the app that append X-Forwarded-For. 0 (default) ignores
# the header, because any client can send it. Set 1 behind nginx / IIS ARR / a load balancer, and
# block direct access to the app's port.
# TRUSTED_PROXY_HOPS="0"
# Password checks run on worker threads: threads (default min(2, cores - 1)), waiting checks
# (default 12 x threads), longest wait and longest check in milliseconds.
# AUTH_HASH_THREADS="2"
# AUTH_HASH_MAX_QUEUE="24"
# AUTH_HASH_QUEUE_TIMEOUT_MS="5000"
# AUTH_HASH_JOB_TIMEOUT_MS="10000"
# Places kept for sign-ins from known devices and signed-in users, and checks one client may run at once.
# AUTH_HASH_PRIORITY_RESERVE="9"
# AUTH_HASH_MAX_PER_CLIENT="2"
# Sign-in limits: per account and per address per window, and per minute across everything.
# LOGIN_MAX_FAILURES_PER_ACCOUNT="5"
# LOGIN_MAX_FAILURES_PER_ACCOUNT_TOTAL="10"
# Successful sign-ins per account per window (bounds what one valid password can do).
# LOGIN_MAX_SUCCESSES_PER_ACCOUNT="100"
# LOGIN_MAX_FAILURES_PER_IP="30"
# LOGIN_FAILURE_WINDOW_MINUTES="15"
# LOGIN_MAX_FAILURES_GLOBAL_PER_MINUTE="300"
# Days raw sign-in records (login_attempts) are kept.
# LOGIN_ATTEMPT_RETENTION_DAYS="30"
# Longest time a JSON request body may take to arrive (milliseconds).
# JSON_BODY_TIMEOUT_MS="60000"
# Upload bodies being received at once in one process (MB), and their idle / total timeouts (ms).
# UPLOAD_MAX_INFLIGHT_MB="256"
# UPLOAD_IDLE_TIMEOUT_MS="30000"
# UPLOAD_TOTAL_TIMEOUT_MS="900000"
# One user's share of that budget, simultaneous uploads per user, and the slowest accepted speed
# after a grace period.
# UPLOAD_MAX_INFLIGHT_PER_USER_MB="64"
# UPLOAD_MAX_CONCURRENT_PER_USER="3"
# UPLOAD_MIN_RATE_KBPS="8"
# UPLOAD_MIN_RATE_GRACE_MS="10000"
