# PostgreSQL connection string used by the application and Prisma.
DATABASE_URL="postgresql://ims:change_me@localhost:5432/installation_manager?schema=public"

# Separate database used ONLY by the automated integration tests (it is wiped between tests).
TEST_DATABASE_URL="postgresql://ims:change_me@localhost:5432/installation_manager_test?schema=public"

# Public base URL of the app. Used to build password set/reset links shown to admins.
APP_URL="http://localhost:3000"

# Session lifetime in hours (default 12).
SESSION_TTL_HOURS="12"

# Password for the accounts created by `npm run db:seed` (development only).
SEED_PASSWORD="ChangeMe123!"

# Folder for visit photos, signatures and payment proofs (default: ./storage/uploads). Keep it
# outside the public folder and back it up together with the database.
# UPLOAD_DIR="D:\ims-uploads"
# Largest accepted upload in megabytes (default 8). Photos are shrunk in the browser first.
# MAX_UPLOAD_MB="8"
