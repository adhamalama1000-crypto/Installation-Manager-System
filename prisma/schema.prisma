// Installation Manager System - database schema.
//
// Notes on invariants that live in SQL (see migrations), because Prisma cannot express them:
//  * appointment_technicians has an EXCLUSION constraint that makes it impossible for a
//    technician to hold two overlapping schedule-blocking assignments, even under concurrent
//    requests. The service layer checks first (for a friendly message); the database is the
//    final guarantee.
//  * audit_logs rows cannot be updated or deleted (trigger).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SALES
  TECHNICIAN
  VIEWER
  /// Receives the cash technicians collect and sees the monthly finance statement.
  ACCOUNTANT
  /// Store keeper: registers serial-numbered stock and hands it to technicians.
  STORE
  /// Company car driver: drops the teams at their visits and picks them up (Aura: سواق).
  DRIVER
  /// Runs the warehouses: catalogue, stock documents, stocktakes and their approval.
  WAREHOUSE_MANAGER
}

/// Where a serial-numbered item is (Aura: في المخزن / عهدة / اتركب / مرتجع / عطلان).
enum StockStatus {
  IN_STORE
  WITH_TECHNICIAN
  INSTALLED
  RETURNED
  FAULTY
}

/// How a customer paid (Aura: كاش / إنستاباي / فودافون كاش / تحويل بنكي).
enum PaymentMethod {
  CASH
  INSTAPAY
  VODAFONE_CASH
  BANK_TRANSFER
}

/// Cash a technician collected: held by the technician until the accountant receives it.
enum CustodyStatus {
  HELD
  RECEIVED
  /// The collection was corrected (no longer cash, or zero) before it was handed over.
  VOID
}

enum ProductCategory {
  SMART_LOCK
  SMART_HOME
  CCTV
  INTERCOM
  OTHER
}

/// What the visit is for (Aura: معاينة / تركيب / تكملة / برمجة / صيانة).
enum VisitType {
  INSPECTION
  INSTALLATION
  COMPLETION
  PROGRAMMING
  MAINTENANCE
}

/// Whether the customer has confirmed the booked time.
enum CustomerConfirmation {
  PENDING
  CONFIRMED
  RESCHEDULE_REQUESTED
  UNREACHABLE
}

/// Why a technician is unavailable on a day (Aura's leave/sick/absence).
enum LeaveType {
  LEAVE
  SICK
  ABSENCE
}

enum LeaveStatus {
  REQUESTED
  APPROVED
  REJECTED
  CANCELLED
}

/// What an uploaded file is (Aura: صور السيلز / صور الفني / توقيع العميل / صورة التحويل / صورة العربون).
enum AttachmentKind {
  /// Site photos sent before the visit (by Sales or the customer).
  BEFORE_PHOTO
  /// Photos of the finished work, taken by the technician.
  AFTER_PHOTO
  /// The customer's signature on handover (one current signature per visit).
  SIGNATURE
  /// Screenshot of a transfer collected at the visit (one current proof per visit).
  PAYMENT_PROOF
  /// Screenshot of the deposit transfer (one current proof per visit).
  DEPOSIT_PROOF
  /// A short video of the work (MP4, QuickTime or WebM), when the evidence rule asks for one.
  VIDEO
}

/// Semantic meaning of a (configurable) appointment status. Used for dashboard counts and
/// reports so admins can rename or add statuses without breaking the statistics.
/// Aura's complaint states: جديدة / اتوزعت / اتحلت / مقفولة.
enum ComplaintStatus {
  NEW
  ASSIGNED
  RESOLVED
  CLOSED
}

/// Aura's check-in stages, in the order of a working day: arrive at the company, pick up the
/// lock, confirm with the customer that the site is ready, leave, arrive, start, finish (or report
/// a problem), and leave for the day.
enum CheckInKind {
  COMPANY
  PICKUP
  READY
  DEPART
  ARRIVE
  START
  DONE
  PROBLEM
  LEAVE
  /// The company car leaves the company, drops a team, picks a team up, is back.
  CAR_GO
  CAR_DROP
  CAR_PICK
  CAR_BACK
}

/// A transport expense: PENDING until the accountant pays it out; CANCELLED by its owner before then.
enum ExpenseStatus {
  PENDING
  PAID
  CANCELLED
}

/// What a technician installs (Aura spec: لوك / سمارت هوم / الاتنين); null = both.
enum TechnicianSpecialty {
  LOCK
  SMART_HOME
  BOTH
}

/// Smart-home site readiness (Aura foundation / internet).
enum ReadinessState {
  UNKNOWN
  NOT_READY
  READY
}

/// Where the lock is picked up (Aura lockWhere: مقر الشركة / عند العميل / لسه مش متحدد).
enum LockLocation {
  COMPANY
  CUSTOMER
  UNDECIDED
}

/// Whether an electrician is needed (Aura electrician).
enum ElectricianNeed {
  CUSTOMER_PROVIDES
  COMPANY_PROVIDES
  NOT_NEEDED
}

enum StatusKind {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  POSTPONED
  CANCELLED
  UNABLE_TO_COMPLETE
  /// The visit happened but the job needs another visit (follow-up).
  NEEDS_REVISIT
}

model User {
  id                String               @id @default(cuid())
  name              String
  /// Stored lower-cased; used as the login identifier.
  email             String               @unique
  phone             String?
  role              Role
  isActive          Boolean              @default(true)
  /// bcrypt hash. Null until the user sets a password through an invitation link.
  passwordHash      String?
  /// Calendar colour (hex, e.g. #E55823). Used for Sales employees; kept if the role changes so
  /// historical appointments keep their colour.
  color             String?
  /// Fine-grained permissions that only apply to the VIEWER role (see src/lib/permissions.ts).
  viewerPermissions String[]             @default([])
  createdAt         DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime             @updatedAt @db.Timestamptz(3)
  passwordChangedAt DateTime?            @db.Timestamptz(3)
  /// Interface language chosen by the user ("ar" or "en"); null = not chosen yet (Arabic).
  locale            String?
  /// Technicians: what they install, used to suggest the right person when booking.
  specialty         TechnicianSpecialty?

  sessions              Session[]
  passwordTokens        PasswordToken[]         @relation("TokenUser")
  issuedTokens          PasswordToken[]         @relation("TokenIssuer")
  createdAppointments   Appointment[]           @relation("AppointmentCreator")
  updatedAppointments   Appointment[]           @relation("AppointmentUpdater")
  reportedAppointments  Appointment[]           @relation("AppointmentReporter")
  collectedAppointments Appointment[]           @relation("AppointmentCollector")
  cashHeld              CashCustody[]           @relation("CustodyTechnician")
  cashReceived          CashCustody[]           @relation("CustodyReceiver")
  stockHeld             StockItem[]             @relation("StockHolder")
  stockRegistered       StockItem[]             @relation("StockCreator")
  stockMovesMade        StockMovement[]         @relation("StockActor")
  stockMovesReceived    StockMovement[]         @relation("StockMoveHolder")
  leaves                TechnicianLeave[]       @relation("LeaveUser")
  leavesRequested       TechnicianLeave[]       @relation("LeaveRequester")
  leavesDecided         TechnicianLeave[]       @relation("LeaveDecider")
  assignments           AppointmentTechnician[] @relation("AssignmentTechnician")
  assignedByMe          AppointmentTechnician[] @relation("AssignmentAssigner")
  auditLogs             AuditLog[]
  notifications         Notification[]
  settingsUpdated       Setting[]
  attachmentsUploaded   Attachment[]            @relation("AttachmentUploader")
  attachmentsDeleted    Attachment[]            @relation("AttachmentDeleter")
  ratedAppointments     Appointment[]           @relation("AppointmentRater")
  gradedAppointments    Appointment[]           @relation("AppointmentGrader")
  complaintsOpened      Complaint[]             @relation("ComplaintCreator")
  complaintsAssigned    Complaint[]             @relation("ComplaintAssignee")
  complaintsResolved    Complaint[]             @relation("ComplaintResolver")
  complaintsClosed      Complaint[]             @relation("ComplaintCloser")
  maintenanceCalls      MaintenanceCall[]       @relation("MaintenanceCaller")
  checkIns              CheckIn[]               @relation("CheckInUser")
  position              TechnicianPosition?
  expenses              TransportExpense[]      @relation("ExpenseUser")
  expensesPaid          TransportExpense[]      @relation("ExpensePayer")
  holdsMade             SlotHold[]              @relation("HoldUser")
  holdsOn               SlotHold[]              @relation("HoldTechnician")
  productsCreated       Product[]               @relation("ProductCreator")
  productsUpdated       Product[]               @relation("ProductUpdater")
  warehousesCreated     Warehouse[]             @relation("WarehouseCreator")
  /// The technician's vehicle, kept as a warehouse of kind VEHICLE (created by hand, never automatically).
  vehicle               Warehouse?              @relation("VehicleTechnician")
  stockDocsCreated      StockDocument[]         @relation("StockDocCreator")
  stockDocsPosted       StockDocument[]         @relation("StockDocPoster")
  stockDocsCancelled    StockDocument[]         @relation("StockDocCanceller")
  inventoryMovements    InventoryMovement[]     @relation("InventoryMovementActor")
  stocktakesCreated     Stocktake[]             @relation("StocktakeCreator")
  stocktakesSubmitted   Stocktake[]             @relation("StocktakeSubmitter")
  stocktakesDecided     Stocktake[]             @relation("StocktakeDecider")
  stocktakeLinesCounted StocktakeLine[]         @relation("StocktakeCounter")
  productImagesUploaded ProductImage[]          @relation("ProductImageUploader")
  suppliersCreated      Supplier[]              @relation("SupplierCreator")
  productImagesDeleted  ProductImage[]          @relation("ProductImageDeleter")

  salesCreated   SalesInvoice[] @relation("SaleCreator")
  salesConfirmed SalesInvoice[] @relation("SaleConfirmer")
  salesCancelled SalesInvoice[] @relation("SaleCanceller")

  workLocationsCreated WorkLocation[]     @relation("WorkLocationCreator")
  attendanceReviews    AttendanceReview[] @relation("AttendanceReviewer")
  evidenceRulesEdited  EvidenceRule[]     @relation("EvidenceRuleEditor")
  workReviews          WorkReview[]       @relation("WorkReviewActor")

  @@index([role, isActive])
  @@map("users")
}

model Session {
  /// SHA-256 of the random token stored in the browser cookie. The raw token is never stored.
  id         String   @id
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  lastSeenAt DateTime @default(now()) @db.Timestamptz(3)
  userAgent  String?
  ipAddress  String?

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// One-time links used for account invitations and admin-initiated password resets.
model PasswordToken {
  id          String    @id @default(cuid())
  /// SHA-256 of the token in the link.
  tokenHash   String    @unique
  userId      String
  user        User      @relation("TokenUser", fields: [userId], references: [id], onDelete: Cascade)
  purpose     String // "INVITE" | "RESET"
  expiresAt   DateTime  @db.Timestamptz(3)
  usedAt      DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  createdById String?
  createdBy   User?     @relation("TokenIssuer", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("password_tokens")
}

/// Records login attempts for rate limiting (works across multiple app instances).
model LoginAttempt {
  id        BigInt   @id @default(autoincrement())
  email     String
  ipAddress String
  success   Boolean
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
  @@map("login_attempts")
}

model Customer {
  id                   String   @id @default(cuid())
  name                 String
  phone                String
  /// Digits only, used for searching and for matching repeat customers.
  phoneDigits          String
  secondaryPhone       String?
  secondaryPhoneDigits String?
  createdAt            DateTime @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @db.Timestamptz(3)

  locations      CustomerLocation[]
  appointments   Appointment[]
  stockDocuments StockDocument[]

  salesInvoices SalesInvoice[]

  @@index([phoneDigits])
  @@index([secondaryPhoneDigits])
  @@index([name])
  @@index([updatedAt])
  /// Trigram indexes make "contains" searches (ILIKE '%...%') use an index (needs pg_trgm).
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "customers_name_trgm_idx")
  @@index([phoneDigits(ops: raw("gin_trgm_ops"))], type: Gin, map: "customers_phoneDigits_trgm_idx")
  @@index([secondaryPhoneDigits(ops: raw("gin_trgm_ops"))], type: Gin, map: "customers_secondaryPhoneDigits_trgm_idx")
  @@map("customers")
}

/// An installation site belonging to a customer. A repeat customer can have several sites
/// (home, office, ...) and many appointments per site.
model CustomerLocation {
  id                 String   @id @default(cuid())
  customerId         String
  customer           Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  label              String?
  area               String?
  streetAddress      String?
  building           String?
  apartment          String?
  floor              String?
  accessInstructions String?
  /// Map link exactly as entered by the user (validated as http/https).
  mapUrl             String?
  latitude           Decimal? @db.Decimal(9, 6)
  longitude          Decimal? @db.Decimal(9, 6)
  createdAt          DateTime @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @db.Timestamptz(3)

  appointments Appointment[]

  @@index([customerId])
  @@index([area])
  @@index([building])
  @@index([area(ops: raw("gin_trgm_ops"))], type: Gin, map: "customer_locations_area_trgm_idx")
  @@index([building(ops: raw("gin_trgm_ops"))], type: Gin, map: "customer_locations_building_trgm_idx")
  @@index([streetAddress(ops: raw("gin_trgm_ops"))], type: Gin, map: "customer_locations_streetAddress_trgm_idx")
  @@map("customer_locations")
}

model AppointmentStatus {
  id             String     @id @default(cuid())
  name           String     @unique
  /// Arabic name shown in the Arabic interface (falls back to `name`).
  nameAr         String?
  kind           StatusKind
  /// Hex colour for status badges.
  color          String
  /// Whether appointments in this status occupy the assigned technicians' time.
  blocksSchedule Boolean    @default(true)
  /// Status given to newly created appointments (exactly one should be true).
  isDefault      Boolean    @default(false)
  isActive       Boolean    @default(true)
  sortOrder      Int        @default(0)
  createdAt      DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime   @updatedAt @db.Timestamptz(3)

  appointments Appointment[]

  @@map("appointment_statuses")
}

model Appointment {
  id         String           @id @default(cuid())
  /// Sequential number used for the human-readable ID (e.g. APT-000123).
  number     Int              @unique @default(autoincrement())
  customerId String
  customer   Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  locationId String
  location   CustomerLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)

  productCategory      ProductCategory
  /// Null for appointments booked before visit types existed.
  visitType            VisitType?
  customerConfirmation CustomerConfirmation @default(PENDING)
  /// The earlier visit this one continues (a repeat / follow-up visit).
  followUpOfId         String?
  followUpOf           Appointment?         @relation("FollowUp", fields: [followUpOfId], references: [id], onDelete: Restrict)
  followUps            Appointment[]        @relation("FollowUp")
  /// Free-text category when productCategory = OTHER.
  categoryOther        String?
  brand                String?
  model                String?
  description          String?
  requiredEquipment    String?
  additionalNotes      String?
  /// Visible only to roles allowed to see internal notes.
  internalNotes        String?
  /// What the technician did / found, written when recording the outcome of the visit.
  visitReport          String?
  reportedAt           DateTime?            @db.Timestamptz(3)
  reportedById         String?
  reportedBy           User?                @relation("AppointmentReporter", fields: [reportedById], references: [id], onDelete: Restrict)

  /// Price agreed with the customer (EGP). Null when not recorded.
  totalPrice        Decimal?        @db.Decimal(12, 2)
  depositAmount     Decimal?        @db.Decimal(12, 2)
  depositMethod     PaymentMethod?
  /// Charged on top of the price, e.g. for a repeat visit the customer caused.
  extraFee          Decimal?        @db.Decimal(12, 2)
  /// Collected from the customer at the visit, recorded with the visit outcome.
  collectedAmount   Decimal?        @db.Decimal(12, 2)
  collectedMethod   PaymentMethod?
  collectedAt       DateTime?       @db.Timestamptz(3)
  collectedById     String?
  collectedBy       User?           @relation("AppointmentCollector", fields: [collectedById], references: [id], onDelete: Restrict)
  custody           CashCustody?
  /// Delivery checklist items ticked by the technician (ids from src/lib/delivery.ts).
  deliveryChecklist String[]        @default([])
  attachments       Attachment[]
  workReviews       WorkReview[]
  stockItems        StockItem[]
  stockMovements    StockMovement[]

  /// Customer satisfaction (1-5 stars) from the follow-up call after the visit, with their words.
  customerRating   Int?               @db.SmallInt
  ratingNote       String?
  ratedAt          DateTime?          @db.Timestamptz(3)
  ratedById        String?
  ratedBy          User?              @relation("AppointmentRater", fields: [ratedById], references: [id], onDelete: Restrict)
  /// Quality grade (1-5) given by the head of installations after reviewing the work.
  qualityGrade     Int?               @db.SmallInt
  gradedAt         DateTime?          @db.Timestamptz(3)
  gradedById       String?
  gradedBy         User?              @relation("AppointmentGrader", fields: [gradedById], references: [id], onDelete: Restrict)
  maintenanceCalls MaintenanceCall[]
  complaints       Complaint[]        @relation("ComplaintAppointment")
  complaintVisits  Complaint[]        @relation("ComplaintVisit")
  checkIns         CheckIn[]
  expenses         TransportExpense[]
  /// The company car drops the team at this visit (Aura car = نعم), and its place in the day's route.
  needsCar         Boolean            @default(false)
  carSeq           Int?
  /// Smart-home site readiness, where the lock is, and whether an electrician is needed.
  siteFoundation   ReadinessState?
  siteInternet     ReadinessState?
  lockAt           LockLocation?
  electrician      ElectricianNeed?
  /// The quotation link from the company website and what was read from it (Aura quote).
  quoteUrl         String?
  quoteData        Json?

  startsAt        DateTime @db.Timestamptz(3)
  endsAt          DateTime @db.Timestamptz(3)
  durationMinutes Int

  statusId String
  status   AppointmentStatus @relation(fields: [statusId], references: [id], onDelete: Restrict)

  /// The Sales employee who originally created the appointment. Never changes; determines the
  /// appointment colour.
  createdById String
  createdBy   User    @relation("AppointmentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById String?
  updatedBy   User?   @relation("AppointmentUpdater", fields: [updatedById], references: [id], onDelete: Restrict)

  /// Client-generated id that makes "create" idempotent (double clicks / retries).
  clientRequestId String? @unique
  /// Optimistic-locking counter; incremented on every update.
  version         Int     @default(1)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  technicians    AppointmentTechnician[]
  auditLogs      AuditLog[]
  notifications  Notification[]
  stockDocuments StockDocument[]

  salesInvoices SalesInvoice[]

  clockIns CheckIn[] @relation("CheckInRelatedVisit")

  @@index([startsAt])
  @@index([endsAt])
  @@index([statusId, startsAt])
  @@index([createdById, startsAt])
  @@index([customerId])
  @@index([locationId])
  @@index([productCategory])
  @@index([followUpOfId])
  @@index([needsCar, startsAt])
  @@map("appointments")
}

/// Technician assignment. startsAt/endsAt/blocksSchedule are copies of the appointment's values,
/// kept in sync by the service layer, so that PostgreSQL can enforce "no overlapping active
/// assignments per technician" with an exclusion constraint.
model AppointmentTechnician {
  appointmentId  String
  appointment    Appointment @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  technicianId   String
  technician     User        @relation("AssignmentTechnician", fields: [technicianId], references: [id], onDelete: Restrict)
  startsAt       DateTime    @db.Timestamptz(3)
  endsAt         DateTime    @db.Timestamptz(3)
  blocksSchedule Boolean
  assignedAt     DateTime    @default(now()) @db.Timestamptz(3)
  assignedById   String?
  assignedBy     User?       @relation("AssignmentAssigner", fields: [assignedById], references: [id], onDelete: Restrict)

  @@id([appointmentId, technicianId])
  @@index([technicianId, startsAt])
  @@map("appointment_technicians")
}

model AuditLog {
  id            String       @id @default(cuid())
  /// APPOINTMENT | USER | STATUS | SETTINGS | CUSTOMER
  entityType    String
  entityId      String
  /// e.g. APPOINTMENT_CREATED, APPOINTMENT_RESCHEDULED, USER_ROLE_CHANGED ...
  action        String
  summary       String
  /// { key, params }: the summary as a message key, shown in each reader's language. Null on rows
  /// written before localization (their `summary` text is shown).
  summaryData   Json?
  /// { field: { from, to } } for updates, or a snapshot for creations.
  changes       Json?
  actorId       String?
  actor         User?        @relation(fields: [actorId], references: [id], onDelete: Restrict)
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)

  @@index([entityType, entityId, createdAt])
  @@index([appointmentId, createdAt])
  @@index([actorId, createdAt])
  @@index([createdAt])
  @@index([summary(ops: raw("gin_trgm_ops"))], type: Gin, map: "audit_logs_summary_trgm_idx")
  @@map("audit_logs")
}

model Notification {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  type          String
  /// English text (kept for rows written before localization and as a fallback).
  message       String
  /// { key, params }: shown in the reader's language.
  data          Json?
  readAt        DateTime?    @db.Timestamptz(3)
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

/// Key/value system settings (timezone, working hours, role options ...).
model Setting {
  key         String   @id
  value       Json
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  updatedById String?
  updatedBy   User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("settings")
}

/// A day range (company-local dates, inclusive) on which a technician cannot be booked once approved.
/// Technicians request it; Admins approve, reject or add it directly.
model TechnicianLeave {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation("LeaveUser", fields: [userId], references: [id], onDelete: Restrict)
  startDate     DateTime    @db.Date
  endDate       DateTime    @db.Date
  type          LeaveType
  reason        String?
  status        LeaveStatus @default(REQUESTED)
  requestedById String
  requestedBy   User        @relation("LeaveRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  decidedById   String?
  decidedBy     User?       @relation("LeaveDecider", fields: [decidedById], references: [id], onDelete: Restrict)
  decidedAt     DateTime?   @db.Timestamptz(3)
  decisionNote  String?
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime    @updatedAt @db.Timestamptz(3)

  @@index([userId, startDate])
  @@index([status, startDate])
  @@map("technician_leaves")
}

/// One row per appointment whose collection was cash: who holds it, and when the accountant got it.
model CashCustody {
  id            String        @id @default(cuid())
  appointmentId String        @unique
  appointment   Appointment   @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  technicianId  String
  technician    User          @relation("CustodyTechnician", fields: [technicianId], references: [id], onDelete: Restrict)
  amount        Decimal       @db.Decimal(12, 2)
  status        CustodyStatus @default(HELD)
  collectedAt   DateTime      @db.Timestamptz(3)
  receivedById  String?
  receivedBy    User?         @relation("CustodyReceiver", fields: [receivedById], references: [id], onDelete: Restrict)
  receivedAt    DateTime?     @db.Timestamptz(3)
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @db.Timestamptz(3)

  @@index([technicianId, status])
  @@index([status, collectedAt])
  @@map("cash_custody")
}

/// A product model kept in stock, with its warranty (Aura's «models» list: "model | months").
model ProductModel {
  id             String          @id @default(cuid())
  /// Unique, compared case-insensitively by the application.
  name           String          @unique
  category       ProductCategory
  warrantyMonths Int             @default(12)
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(3)
  items          StockItem[]

  @@map("product_models")
}

/// One physical item identified by its serial number.
model StockItem {
  id            String          @id @default(cuid())
  /// Stored trimmed, without spaces, upper-case.
  serial        String          @unique
  modelId       String
  model         ProductModel    @relation(fields: [modelId], references: [id], onDelete: Restrict)
  status        StockStatus     @default(IN_STORE)
  /// The technician holding it (status WITH_TECHNICIAN).
  holderId      String?
  holder        User?           @relation("StockHolder", fields: [holderId], references: [id], onDelete: Restrict)
  /// The visit it was installed on (status INSTALLED).
  appointmentId String?
  appointment   Appointment?    @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  installedAt   DateTime?       @db.Timestamptz(3)
  warrantyUntil DateTime?       @db.Date
  note          String?
  createdById   String
  createdBy     User            @relation("StockCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt     DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @db.Timestamptz(3)
  movements     StockMovement[]

  @@index([status, modelId])
  @@index([holderId, status])
  @@index([appointmentId])
  @@map("stock_items")
}

/// Append-only history of every stock change.
model StockMovement {
  id            String       @id @default(cuid())
  itemId        String
  item          StockItem    @relation(fields: [itemId], references: [id], onDelete: Restrict)
  fromStatus    StockStatus?
  toStatus      StockStatus
  holderId      String?
  holder        User?        @relation("StockMoveHolder", fields: [holderId], references: [id], onDelete: Restrict)
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  note          String?
  actorId       String
  actor         User         @relation("StockActor", fields: [actorId], references: [id], onDelete: Restrict)
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)

  @@index([itemId, createdAt])
  @@map("stock_movements")
}

/// A file attached to a visit (photos, signature, transfer proofs). The bytes live in file storage
/// (UPLOAD_DIR); this row is the record of who uploaded what. Removing a file only marks the row
/// deleted, so the history stays complete.
model Attachment {
  id            String         @id @default(cuid())
  appointmentId String
  appointment   Appointment    @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  kind          AttachmentKind
  /// image/jpeg, image/png or image/webp; video/mp4, video/quicktime or video/webm for VIDEO
  /// (checked against the file's own bytes).
  contentType   String
  byteSize      Int
  sha256        String
  /// Path inside the storage directory; never derived from user input.
  storageKey    String         @unique
  uploadedById  String
  uploadedBy    User           @relation("AttachmentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  deletedAt     DateTime?      @db.Timestamptz(3)
  deletedById   String?
  deletedBy     User?          @relation("AttachmentDeleter", fields: [deletedById], references: [id], onDelete: Restrict)

  @@index([appointmentId, kind, createdAt])
  @@map("attachments")
}

/// A customer complaint about a visit (Aura DB_Complaints). Never deleted; closed and reopened.
model Complaint {
  id            String          @id @default(cuid())
  /// Aura's number: C + year and month + sequence in that month, e.g. C2610-007.
  code          String          @unique
  appointmentId String
  appointment   Appointment     @relation("ComplaintAppointment", fields: [appointmentId], references: [id], onDelete: Restrict)
  description   String
  status        ComplaintStatus @default(NEW)
  /// Latest warranty end of the items installed at the visit when the complaint was opened (null: none recorded).
  warrantyUntil DateTime?       @db.Date
  assignedToId  String?
  assignedTo    User?           @relation("ComplaintAssignee", fields: [assignedToId], references: [id], onDelete: Restrict)
  /// The maintenance visit booked for this complaint; finishing it resolves the complaint.
  visitId       String?
  visit         Appointment?    @relation("ComplaintVisit", fields: [visitId], references: [id], onDelete: Restrict)
  resolution    String?
  resolvedAt    DateTime?       @db.Timestamptz(3)
  resolvedById  String?
  resolvedBy    User?           @relation("ComplaintResolver", fields: [resolvedById], references: [id], onDelete: Restrict)
  closedAt      DateTime?       @db.Timestamptz(3)
  closedById    String?
  closedBy      User?           @relation("ComplaintCloser", fields: [closedById], references: [id], onDelete: Restrict)
  createdById   String
  createdBy     User            @relation("ComplaintCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt     DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @db.Timestamptz(3)
  /// Optimistic-locking counter; incremented on every change.
  version       Int             @default(1)

  @@index([status, createdAt])
  @@index([appointmentId])
  @@index([assignedToId, status])
  @@index([visitId])
  @@map("complaints")
}

/// A maintenance reminder call made 6 or 12 months after an installation (Aura maintNote).
model MaintenanceCall {
  id            String      @id @default(cuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  /// 6 or 12 (months after the installation).
  milestone     Int         @db.SmallInt
  note          String?
  calledById    String
  calledBy      User        @relation("MaintenanceCaller", fields: [calledById], references: [id], onDelete: Restrict)
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)

  @@unique([appointmentId, milestone])
  @@map("maintenance_calls")
}

/// A technician's check-in (Aura DB_Checkins): where and when each stage of the day happened.
/// Append-only (trigger). Coordinates are null when the browser gave no location.
model CheckIn {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation("CheckInUser", fields: [userId], references: [id], onDelete: Restrict)
  kind          CheckInKind
  /// The visit, for visit stages (null for COMPANY and LEAVE).
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  /// Company-local day of the check-in.
  day           DateTime     @db.Date
  latitude      Decimal?     @db.Decimal(9, 6)
  longitude     Decimal?     @db.Decimal(9, 6)
  accuracyM     Int?
  /// Metres to the company (COMPANY, LEAVE) or to the customer's pin (visit stages).
  distanceM     Int?
  /// Expected arrival at the customer, estimated on DEPART.
  etaAt         DateTime?    @db.Timestamptz(3)
  /// Minutes after the start of the working day (plus grace) on COMPANY.
  lateMinutes   Int?
  /// Minutes before the end of the working day on LEAVE.
  earlyMinutes  Int?
  /// More than 400 m from the company or 300 m from the customer.
  far           Boolean      @default(false)
  /// PROBLEM reason (lib/field.ts PROBLEM_REASONS).
  reason        String?
  note          String?
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)

  /// Clock-in / out at a customer's site: the visit it relates to (appointmentId is for visit stages only).
  relatedAppointmentId String?
  relatedAppointment   Appointment?       @relation("CheckInRelatedVisit", fields: [relatedAppointmentId], references: [id], onDelete: Restrict)
  /// Clock-in / out: where the person said they are, and the approved work location.
  site                 AttendanceSite?
  workLocationId       String?
  workLocation         WorkLocation?      @relation(fields: [workLocationId], references: [id], onDelete: Restrict)
  /// Live-camera selfie in file storage (served only to the person and attendance managers).
  selfieKey            String?            @unique
  selfieContentType    String?
  selfieSha256         String?
  /// The geofence radius applied and the expected position (company, customer pin, work location).
  geofenceM            Int?
  expectedLatitude     Decimal?           @db.Decimal(9, 6)
  expectedLongitude    Decimal?           @db.Decimal(9, 6)
  reviews              AttendanceReview[]

  @@index([day, userId])
  @@index([relatedAppointmentId])
  @@index([appointmentId, kind])
  @@index([userId, createdAt])
  @@map("check_ins")
}

/// A technician's latest position while on the way to a customer (Aura api_ping), one row per
/// technician, overwritten. Used only to refresh the expected arrival on the live board.
model TechnicianPosition {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  latitude  Decimal  @db.Decimal(9, 6)
  longitude Decimal  @db.Decimal(9, 6)
  accuracyM Int?
  at        DateTime @db.Timestamptz(3)

  @@map("technician_positions")
}

/// Late alerts already sent, so each one goes out once a day (Aura ALERTED_<date>).
model AlertSent {
  day       DateTime @db.Date
  key       String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@id([day, key])
  @@map("alerts_sent")
}

/// Transport a technician or the driver paid for (Aura DB_Expenses), paid back by the accountant.
model TransportExpense {
  id                 String        @id @default(cuid())
  userId             String
  user               User          @relation("ExpenseUser", fields: [userId], references: [id], onDelete: Restrict)
  appointmentId      String?
  appointment        Appointment?  @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  /// Company-local day of the expense.
  day                DateTime      @db.Date
  amount             Decimal       @db.Decimal(12, 2)
  note               String?
  /// Receipt photo in file storage (UPLOAD_DIR), served only to the owner and finance.
  receiptKey         String?       @unique
  receiptContentType String?
  status             ExpenseStatus @default(PENDING)
  paidAt             DateTime?     @db.Timestamptz(3)
  paidById           String?
  paidBy             User?         @relation("ExpensePayer", fields: [paidById], references: [id], onDelete: Restrict)
  createdAt          DateTime      @default(now()) @db.Timestamptz(3)

  @@index([userId, day])
  @@index([status, day])
  @@map("transport_expenses")
}

/// A 10-minute hold on a technician's time while Sales is on the phone with a customer (Aura api_hold).
model SlotHold {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation("HoldUser", fields: [userId], references: [id], onDelete: Cascade)
  technicianId String
  technician   User     @relation("HoldTechnician", fields: [technicianId], references: [id], onDelete: Cascade)
  startsAt     DateTime @db.Timestamptz(3)
  endsAt       DateTime @db.Timestamptz(3)
  expiresAt    DateTime @db.Timestamptz(3)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  @@index([technicianId, expiresAt])
  @@index([userId])
  @@map("slot_holds")
}

// ---------------------------------------------------------------------------------------------
// ERP inventory foundation (phase 1): product catalogue, warehouses and bins, an immutable stock
// ledger with per-location balances, numbered stock documents and physical stocktakes.
//
// Invariants that live in SQL (see migration 20261101120100_inventory_foundation):
//  * inventory_movements rows cannot be updated or deleted (trigger). Corrections are REVERSAL
//    movements written when a posted document is cancelled.
//  * stock_documents can be edited only while DRAFT; afterwards only POSTED -> CANCELLED is
//    allowed, and rows are never deleted. stock_document_lines change only while the document
//    is DRAFT.
//  * stock_balances.quantity cannot go below zero unless the warehouse allows negative stock
//    (and never for serial-tracked products).
//  * A product's unit and serial tracking cannot change once it has movements.
//  * CHECK constraints: SKU / code formats, positive line quantities, which warehouses each
//    document type uses, and that only a VEHICLE warehouse belongs to a technician.
// The legacy serial custody (product_models / stock_items / stock_movements) is untouched.
// ---------------------------------------------------------------------------------------------

enum WarehouseKind {
  /// A building or store room.
  WAREHOUSE
  /// A technician's vehicle (its stock is the technician's custody).
  VEHICLE
}

enum StockDocType {
  /// Opening balance when a warehouse starts on the system.
  OPENING
  /// Goods received from a supplier.
  RECEIPT
  /// Stock issued out of a warehouse (to a site, for use).
  ISSUE
  /// Moved between warehouses (or between bins of one warehouse).
  TRANSFER
  /// Customer return (into a warehouse) or supplier return (out of a warehouse).
  RETURN
  /// Increase or decrease after a count or a correction.
  ADJUSTMENT
}

enum StockDocStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum StockReturnKind {
  CUSTOMER
  SUPPLIER
}

enum AdjustDirection {
  INCREASE
  DECREASE
}

enum InventoryMovementType {
  OPENING_BALANCE
  GOODS_RECEIPT
  ISSUE
  TRANSFER_OUT
  TRANSFER_IN
  CUSTOMER_RETURN
  SUPPLIER_RETURN
  ADJUSTMENT_INCREASE
  ADJUSTMENT_DECREASE
  /// Undoes one earlier movement (reversesId) when its posted document is cancelled.
  REVERSAL
}

enum StocktakeStatus {
  COUNTING
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
}

/// Unit of measure (Piece, Meter, Box, Set, Roll, ...). Managed in the catalogue setup.
model Unit {
  id             String    @id @default(cuid())
  /// Upper-case short code, e.g. PCS, M, BOX.
  code           String    @unique
  nameEn         String
  nameAr         String
  /// Whether quantities may have decimals (e.g. 2.5 meters).
  allowsFraction Boolean   @default(false)
  isActive       Boolean   @default(true)
  sortOrder      Int       @default(0)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)
  products       Product[]

  @@map("units")
}

/// Product category; a category with a parent is a subcategory (two levels).
model CatalogCategory {
  id        String            @id @default(cuid())
  /// Optional upper-case prefix for automatic SKUs (e.g. LCK -> LCK-00001); unique.
  code      String?           @unique
  nameEn    String
  nameAr    String
  parentId  String?
  parent    CatalogCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  CatalogCategory[] @relation("CategoryTree")
  isActive  Boolean           @default(true)
  sortOrder Int               @default(0)
  createdAt DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt DateTime          @updatedAt @db.Timestamptz(3)
  products  Product[]

  @@index([parentId])
  @@map("catalog_categories")
}

model Brand {
  id        String    @id @default(cuid())
  /// Unique, compared case-insensitively by the application.
  name      String    @unique
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  products  Product[]

  @@map("brands")
}

/// A stock-keeping product (the ERP catalogue). Quantities live in stock_balances.
model Product {
  id              String              @id @default(cuid())
  /// Upper-case, unique.
  sku             String              @unique
  /// Unique when given.
  barcode         String?             @unique
  nameEn          String
  nameAr          String
  /// A category or a subcategory (its parent is then the category).
  categoryId      String?
  category        CatalogCategory?    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brandId         String?
  brand           Brand?              @relation(fields: [brandId], references: [id], onDelete: Restrict)
  model           String?
  description     String?
  unitId          String
  unit            Unit                @relation(fields: [unitId], references: [id], onDelete: Restrict)
  /// Default purchase cost (used for a receipt line without its own cost).
  purchaseCost    Decimal?            @db.Decimal(12, 2)
  sellingPrice    Decimal?            @db.Decimal(12, 2)
  /// Moving average cost over all warehouses, kept by the posting engine.
  averageCost     Decimal             @default(0) @db.Decimal(14, 4)
  /// Low-stock threshold (total over all warehouses).
  minStock        Decimal             @default(0) @db.Decimal(14, 3)
  warrantyMonths  Int                 @default(0)
  /// Every unit has a serial number recorded on each movement (serial mode "mandatory").
  trackSerials    Boolean             @default(false)
  /// Serial numbers are recorded when known, not for every unit (serial mode "optional").
  serialsOptional Boolean             @default(false)
  /// This product has variants (colours, configurations): it holds no stock itself, its variants do.
  hasVariants     Boolean             @default(false)
  /// The product this one is a variant of. Category, brand, unit, warranty and serial mode follow the parent.
  parentId        String?
  parent          Product?            @relation("ProductVariants", fields: [parentId], references: [id], onDelete: Restrict)
  variants        Product[]           @relation("ProductVariants")
  /// The variant's own name ("Black" / "أسود"); nameEn / nameAr hold the full name.
  variantNameEn   String?
  variantNameAr   String?
  /// Swatch colour of the variant (#RRGGBB).
  colorHex        String?
  isActive        Boolean             @default(true)
  /// Optimistic-locking counter.
  version         Int                 @default(1)
  createdById     String
  createdBy       User                @relation("ProductCreator", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById     String?
  updatedBy       User?               @relation("ProductUpdater", fields: [updatedById], references: [id], onDelete: Restrict)
  createdAt       DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime            @updatedAt @db.Timestamptz(3)
  balances        StockBalance[]
  lines           StockDocumentLine[]
  movements       InventoryMovement[]
  serials         ProductSerial[]
  stocktakeLines  StocktakeLine[]
  images          ProductImage[]

  salesLines SalesInvoiceLine[]

  @@index([categoryId])
  @@index([parentId])
  @@index([brandId])
  @@index([isActive, nameEn])
  @@index([createdAt])
  @@index([nameEn(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_nameEn_trgm_idx")
  @@index([nameAr(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_nameAr_trgm_idx")
  @@index([sku(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_sku_trgm_idx")
  @@map("products")
}

/// A place that holds stock: a warehouse building or a technician's vehicle.
model Warehouse {
  id            String              @id @default(cuid())
  /// Upper-case, unique, e.g. MAIN, VAN-KARIM.
  code          String              @unique
  nameEn        String
  nameAr        String
  kind          WarehouseKind       @default(WAREHOUSE)
  /// The technician whose vehicle this is (kind VEHICLE only); their stock custody.
  technicianId  String?             @unique
  technician    User?               @relation("VehicleTechnician", fields: [technicianId], references: [id], onDelete: Restrict)
  address       String?
  /// Negative-stock policy for this warehouse; off by default.
  allowNegative Boolean             @default(false)
  isActive      Boolean             @default(true)
  version       Int                 @default(1)
  createdById   String
  createdBy     User                @relation("WarehouseCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt     DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime            @updatedAt @db.Timestamptz(3)
  bins          WarehouseBin[]
  balances      StockBalance[]
  documentsFrom StockDocument[]     @relation("DocFromWarehouse")
  documentsTo   StockDocument[]     @relation("DocToWarehouse")
  movements     InventoryMovement[] @relation("MovementWarehouse")
  serials       ProductSerial[]
  stocktakes    Stocktake[]

  salesInvoices SalesInvoice[]

  @@index([kind, isActive])
  @@map("warehouses")
}

/// A shelf / bin inside a warehouse (optional location for stock).
model WarehouseBin {
  id             String              @id @default(cuid())
  warehouseId    String
  warehouse      Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  /// Upper-case, unique inside the warehouse.
  code           String
  name           String?
  isActive       Boolean             @default(true)
  createdAt      DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @db.Timestamptz(3)
  balances       StockBalance[]
  movements      InventoryMovement[]
  serials        ProductSerial[]
  linesFrom      StockDocumentLine[] @relation("LineFromBin")
  linesTo        StockDocumentLine[] @relation("LineToBin")
  stocktakeLines StocktakeLine[]

  @@unique([warehouseId, code])
  @@map("warehouse_bins")
}

/// On-hand quantity of a product at one location (a warehouse, or one of its bins). Written only
/// by the posting engine, in the same transaction as the ledger movements.
model StockBalance {
  id          String        @id @default(cuid())
  productId   String
  product     Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouseId String
  warehouse   Warehouse     @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  binId       String?
  bin         WarehouseBin? @relation(fields: [binId], references: [id], onDelete: Restrict)
  /// binId, or "" for stock not put in a bin (so the location is unique; CHECK keeps them equal).
  binKey      String        @default("")
  quantity    Decimal       @default(0) @db.Decimal(14, 3)
  updatedAt   DateTime      @default(now()) @db.Timestamptz(3)

  @@unique([productId, warehouseId, binKey])
  @@index([warehouseId, productId])
  @@map("stock_balances")
}

/// Running counter for document numbers, one row per prefix and year (e.g. GRN-2026).
model DocumentSequence {
  key        String @id
  lastNumber Int    @default(0)

  @@map("document_sequences")
}

/// A numbered stock document: draft, then posted (writes the ledger), or cancelled (a posted one
/// is cancelled by reversal movements; nothing is deleted).
model StockDocument {
  id              String              @id @default(cuid())
  /// e.g. GRN-2026-000001; assigned when the draft is created.
  number          String              @unique
  type            StockDocType
  status          StockDocStatus      @default(DRAFT)
  returnKind      StockReturnKind?
  /// Source warehouse (issue, transfer, supplier return).
  fromWarehouseId String?
  fromWarehouse   Warehouse?          @relation("DocFromWarehouse", fields: [fromWarehouseId], references: [id], onDelete: Restrict)
  /// Destination warehouse (opening, receipt, transfer, customer return) or the adjusted one.
  toWarehouseId   String?
  toWarehouse     Warehouse?          @relation("DocToWarehouse", fields: [toWarehouseId], references: [id], onDelete: Restrict)
  /// Business date of the document (company-local day).
  documentDate    DateTime            @db.Date
  /// External reference: supplier invoice, delivery note, visit code...
  reference       String?
  /// Supplier or customer name (free text until the supplier and customer masters link here).
  counterparty    String?
  note            String?
  /// The stocktake this adjustment came from.
  stocktakeId     String?             @unique
  stocktake       Stocktake?          @relation(fields: [stocktakeId], references: [id], onDelete: Restrict)
  /// Client-generated id that makes "create" idempotent (double clicks / retries).
  clientRequestId String?             @unique
  version         Int                 @default(1)
  createdById     String
  createdBy       User                @relation("StockDocCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt       DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime            @updatedAt @db.Timestamptz(3)
  postedAt        DateTime?           @db.Timestamptz(3)
  postedById      String?
  postedBy        User?               @relation("StockDocPoster", fields: [postedById], references: [id], onDelete: Restrict)
  cancelledAt     DateTime?           @db.Timestamptz(3)
  cancelledById   String?
  cancelledBy     User?               @relation("StockDocCanceller", fields: [cancelledById], references: [id], onDelete: Restrict)
  cancelReason    String?
  /// The supplier (receipts, supplier returns) and customer (customer returns), when chosen from
  /// the masters; `counterparty` keeps the name as text for older documents.
  supplierId      String?
  supplier        Supplier?           @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  customerId      String?
  customer        Customer?           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  /// The booked visit this stock was issued for (or returned from).
  appointmentId   String?
  appointment     Appointment?        @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  lines           StockDocumentLine[]
  movements       InventoryMovement[]

  /// The sale whose confirmation posted this issue.
  salesInvoice SalesInvoice?

  @@index([type, status, documentDate])
  @@index([status, createdAt])
  @@index([fromWarehouseId, documentDate])
  @@index([toWarehouseId, documentDate])
  @@index([supplierId, documentDate])
  @@index([customerId])
  @@index([appointmentId])
  @@map("stock_documents")
}

model StockDocumentLine {
  id         String              @id @default(cuid())
  documentId String
  document   StockDocument       @relation(fields: [documentId], references: [id], onDelete: Restrict)
  lineNo     Int
  productId  String
  product    Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity   Decimal             @db.Decimal(14, 3)
  /// Cost per unit for incoming stock; null = the product's purchase cost (receipt) or average cost.
  unitCost   Decimal?            @db.Decimal(14, 4)
  fromBinId  String?
  fromBin    WarehouseBin?       @relation("LineFromBin", fields: [fromBinId], references: [id], onDelete: Restrict)
  toBinId    String?
  toBin      WarehouseBin?       @relation("LineToBin", fields: [toBinId], references: [id], onDelete: Restrict)
  /// Adjustment lines only.
  direction  AdjustDirection?
  serials    String[]            @default([])
  reason     String?
  movements  InventoryMovement[]

  @@unique([documentId, lineNo])
  @@index([productId])
  @@map("stock_document_lines")
}

/// The stock ledger: one row per product per location change. Append-only.
model InventoryMovement {
  id              String                @id @default(cuid())
  documentId      String
  document        StockDocument         @relation(fields: [documentId], references: [id], onDelete: Restrict)
  lineId          String
  line            StockDocumentLine     @relation(fields: [lineId], references: [id], onDelete: Restrict)
  type            InventoryMovementType
  productId       String
  product         Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  /// The location whose balance this movement changes.
  warehouseId     String
  warehouse       Warehouse             @relation("MovementWarehouse", fields: [warehouseId], references: [id], onDelete: Restrict)
  binId           String?
  bin             WarehouseBin?         @relation(fields: [binId], references: [id], onDelete: Restrict)
  /// Signed: positive into the location, negative out of it.
  quantity        Decimal               @db.Decimal(14, 3)
  /// Where the stock came from / went to (the document's source and destination).
  fromWarehouseId String?
  toWarehouseId   String?
  /// Cost per unit used for this movement (valuation).
  unitCost        Decimal               @db.Decimal(14, 4)
  serials         String[]              @default([])
  reason          String?
  /// The movement this one reverses (REVERSAL only).
  reversesId      String?               @unique
  reverses        InventoryMovement?    @relation("MovementReversal", fields: [reversesId], references: [id], onDelete: Restrict)
  reversedBy      InventoryMovement?    @relation("MovementReversal")
  /// The product's total at this warehouse right after the movement.
  balanceAfter    Decimal               @db.Decimal(14, 3)
  documentDate    DateTime              @db.Date
  createdById     String
  createdBy       User                  @relation("InventoryMovementActor", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt       DateTime              @default(now()) @db.Timestamptz(3)
  serialsHere     ProductSerial[]

  @@index([productId, createdAt])
  @@index([warehouseId, productId, createdAt])
  @@index([documentId])
  @@index([createdAt])
  @@map("inventory_movements")
}

/// Where each serial number of a serial-tracked product is now (warehouseId null = not in stock:
/// issued, returned to the supplier, or never received).
model ProductSerial {
  id             String             @id @default(cuid())
  productId      String
  product        Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  /// Stored trimmed, without spaces, upper-case.
  serial         String
  warehouseId    String?
  warehouse      Warehouse?         @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  binId          String?
  bin            WarehouseBin?      @relation(fields: [binId], references: [id], onDelete: Restrict)
  lastMovementId String?
  lastMovement   InventoryMovement? @relation(fields: [lastMovementId], references: [id], onDelete: Restrict)
  createdAt      DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @db.Timestamptz(3)

  @@unique([productId, serial])
  @@index([warehouseId, productId])
  @@index([serial])
  @@map("product_serials")
}

/// A physical count of one warehouse: snapshot, counts, submission, approval (which posts an
/// adjustment document) or rejection.
model Stocktake {
  id            String          @id @default(cuid())
  /// e.g. STK-2026-000001.
  number        String          @unique
  warehouseId   String
  warehouse     Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  status        StocktakeStatus @default(COUNTING)
  note          String?
  /// When the system quantities were taken. The warehouse is frozen until the stocktake closes.
  snapshotAt    DateTime        @db.Timestamptz(3)
  createdById   String
  createdBy     User            @relation("StocktakeCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt     DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @db.Timestamptz(3)
  submittedById String?
  submittedBy   User?           @relation("StocktakeSubmitter", fields: [submittedById], references: [id], onDelete: Restrict)
  submittedAt   DateTime?       @db.Timestamptz(3)
  decidedById   String?
  decidedBy     User?           @relation("StocktakeDecider", fields: [decidedById], references: [id], onDelete: Restrict)
  decidedAt     DateTime?       @db.Timestamptz(3)
  decisionNote  String?
  version       Int             @default(1)
  lines         StocktakeLine[]
  adjustment    StockDocument?

  @@index([warehouseId, status])
  @@index([status, createdAt])
  @@map("stocktakes")
}

model StocktakeLine {
  id              String        @id @default(cuid())
  stocktakeId     String
  stocktake       Stocktake     @relation(fields: [stocktakeId], references: [id], onDelete: Restrict)
  productId       String
  product         Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  binId           String?
  bin             WarehouseBin? @relation(fields: [binId], references: [id], onDelete: Restrict)
  /// binId, or "" (see StockBalance.binKey).
  binKey          String        @default("")
  /// Quantity on the system when the stocktake started.
  systemQuantity  Decimal       @db.Decimal(14, 3)
  systemSerials   String[]      @default([])
  countedQuantity Decimal?      @db.Decimal(14, 3)
  countedSerials  String[]      @default([])
  /// Explanation of a difference (required to submit when counted <> system).
  reason          String?
  countedById     String?
  countedBy       User?         @relation("StocktakeCounter", fields: [countedById], references: [id], onDelete: Restrict)
  countedAt       DateTime?     @db.Timestamptz(3)
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)

  @@unique([stocktakeId, productId, binKey])
  @@map("stocktake_lines")
}

/// A photo of a product or variant (file storage, like visit photos). Removing it only marks the row.
model ProductImage {
  id           String    @id @default(cuid())
  productId    String
  product      Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  contentType  String
  byteSize     Int
  sha256       String
  storageKey   String    @unique
  sortOrder    Int       @default(0)
  uploadedById String
  uploadedBy   User      @relation("ProductImageUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  deletedAt    DateTime? @db.Timestamptz(3)
  deletedById  String?
  deletedBy    User?     @relation("ProductImageDeleter", fields: [deletedById], references: [id], onDelete: Restrict)

  @@index([productId, sortOrder])
  @@map("product_images")
}

/// A supplier (the receipts and supplier returns name it). Never deleted: deactivated.
model Supplier {
  id            String          @id @default(cuid())
  /// Upper-case, unique; generated as SUP-00001 when not typed.
  code          String          @unique
  name          String
  nameAr        String?
  contactPerson String?
  phone         String?
  /// Digits only, for searching.
  phoneDigits   String?
  email         String?
  address       String?
  taxNumber     String?
  notes         String?
  isActive      Boolean         @default(true)
  version       Int             @default(1)
  createdById   String
  createdBy     User            @relation("SupplierCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt     DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @db.Timestamptz(3)
  documents     StockDocument[]

  @@index([isActive, name])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "suppliers_name_trgm_idx")
  @@index([phoneDigits])
  @@map("suppliers")
}

enum SalesInvoiceStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

/// A sale to a customer. Only CONFIRMED invoices count as sales; confirming posts the stock
/// issue (stockDocumentId) through the ledger; cancelling a confirmed one reverses it.
model SalesInvoice {
  id              String             @id @default(cuid())
  /// INV-2026-000001
  number          String             @unique
  status          SalesInvoiceStatus @default(DRAFT)
  invoiceDate     DateTime           @db.Date
  customerId      String?
  customer        Customer?          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  /// Name and phone as on the invoice (a walk-in customer has no customerId).
  customerName    String
  customerPhone   String?
  appointmentId   String?
  appointment     Appointment?       @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  /// The stock leaves from here.
  warehouseId     String
  warehouse       Warehouse          @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  paymentMethod   PaymentMethod?
  note            String?
  subtotal        Decimal            @default(0) @db.Decimal(12, 2)
  discountTotal   Decimal            @default(0) @db.Decimal(12, 2)
  total           Decimal            @default(0) @db.Decimal(12, 2)
  stockDocumentId String?            @unique
  stockDocument   StockDocument?     @relation(fields: [stockDocumentId], references: [id], onDelete: Restrict)
  clientRequestId String?            @unique
  version         Int                @default(1)
  createdById     String
  createdBy       User               @relation("SaleCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt       DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime           @updatedAt @db.Timestamptz(3)
  confirmedAt     DateTime?          @db.Timestamptz(3)
  confirmedById   String?
  confirmedBy     User?              @relation("SaleConfirmer", fields: [confirmedById], references: [id], onDelete: Restrict)
  cancelledAt     DateTime?          @db.Timestamptz(3)
  cancelledById   String?
  cancelledBy     User?              @relation("SaleCanceller", fields: [cancelledById], references: [id], onDelete: Restrict)
  cancelReason    String?
  lines           SalesInvoiceLine[]

  @@index([status, invoiceDate])
  @@index([customerId])
  @@index([appointmentId])
  @@index([warehouseId, invoiceDate])
  @@index([createdById, invoiceDate])
  @@map("sales_invoices")
}

model SalesInvoiceLine {
  id        String       @id @default(cuid())
  invoiceId String
  invoice   SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  lineNo    Int
  productId String
  product   Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity  Decimal      @db.Decimal(14, 3)
  unitPrice Decimal      @db.Decimal(12, 2)
  /// Amount off the line (not a percentage).
  discount  Decimal      @default(0) @db.Decimal(12, 2)
  lineTotal Decimal      @db.Decimal(12, 2)
  /// Cost per unit the stock left at (set on confirmation, for margin and turnover).
  unitCost  Decimal?     @db.Decimal(14, 4)
  serials   String[]     @default([])

  @@unique([invoiceId, lineNo])
  @@index([productId])
  @@map("sales_invoice_lines")
}

enum AttendanceSite {
  COMPANY
  CUSTOMER
  WORK_LOCATION
}

enum AttendanceDecision {
  ACCEPTED
  REJECTED
}

/// An approved place to clock in other than the company (a branch, a large site): a geofence.
model WorkLocation {
  id          String    @id @default(cuid())
  name        String
  nameAr      String?
  latitude    Decimal   @db.Decimal(9, 6)
  longitude   Decimal   @db.Decimal(9, 6)
  radiusM     Int       @default(200)
  isActive    Boolean   @default(true)
  createdById String
  createdBy   User      @relation("WorkLocationCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  checkIns    CheckIn[]

  @@map("work_locations")
}

/// A manager's decision on a flagged clock-in / out (append-only; the latest one counts).
model AttendanceReview {
  id           String             @id @default(cuid())
  checkInId    String
  checkIn      CheckIn            @relation(fields: [checkInId], references: [id], onDelete: Restrict)
  decision     AttendanceDecision
  note         String?
  reviewedById String
  reviewedBy   User               @relation("AttendanceReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  createdAt    DateTime           @default(now()) @db.Timestamptz(3)

  @@index([checkInId, createdAt])
  @@map("attendance_reviews")
}

/// What each kind of visit must show before it is done ('' = any visit type / any category).
/// The most specific active rule applies (src/lib/evidence.ts).
model EvidenceRule {
  id                          String   @id @default(cuid())
  visitType                   String   @default("")
  productCategory             String   @default("")
  minBeforePhotos             Int      @default(0)
  minAfterPhotos              Int      @default(0)
  requireVideo                Boolean  @default(false)
  requireSignature            Boolean  @default(false)
  requireCustomerConfirmation Boolean  @default(false)
  /// A reviewer approves the submitted work (otherwise "done" is final).
  requireReview               Boolean  @default(false)
  isActive                    Boolean  @default(true)
  updatedById                 String?
  updatedBy                   User?    @relation("EvidenceRuleEditor", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt                   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt                   DateTime @updatedAt @db.Timestamptz(3)

  @@unique([visitType, productCategory])
  @@map("evidence_rules")
}

enum WorkReviewEvent {
  SUBMITTED
  APPROVED
  REJECTED
}

/// The review history of a visit's work: append-only events (submitted, approved, rejected with a reason).
model WorkReview {
  id                String          @id @default(cuid())
  appointmentId     String
  appointment       Appointment     @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  event             WorkReviewEvent
  note              String?
  /// The customer confirmed the work at submission (and who confirmed it).
  customerConfirmed Boolean         @default(false)
  customerName      String?
  actorId           String
  actor             User            @relation("WorkReviewActor", fields: [actorId], references: [id], onDelete: Restrict)
  createdAt         DateTime        @default(now()) @db.Timestamptz(3)

  @@index([appointmentId, createdAt])
  @@index([event, createdAt])
  @@map("work_reviews")
}
