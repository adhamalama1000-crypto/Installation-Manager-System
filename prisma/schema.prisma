// Installation Manager System - database schema.
//
// Notes on invariants that live in SQL (see migrations), because Prisma cannot express them:
//  * appointment_technicians has an EXCLUSION constraint that makes it impossible for a
//    technician to hold two overlapping schedule-blocking assignments, even under concurrent
//    requests. The service layer checks first (for a friendly message); the database is the
//    final guarantee.
//  * audit_logs rows cannot be updated or deleted (trigger).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SALES
  TECHNICIAN
  VIEWER
  /// Receives the cash technicians collect and sees the monthly finance statement.
  ACCOUNTANT
  /// Store keeper: registers serial-numbered stock and hands it to technicians.
  STORE
}

/// Where a serial-numbered item is (Aura: في المخزن / عهدة / اتركب / مرتجع / عطلان).
enum StockStatus {
  IN_STORE
  WITH_TECHNICIAN
  INSTALLED
  RETURNED
  FAULTY
}

/// How a customer paid (Aura: كاش / إنستاباي / فودافون كاش / تحويل بنكي).
enum PaymentMethod {
  CASH
  INSTAPAY
  VODAFONE_CASH
  BANK_TRANSFER
}

/// Cash a technician collected: held by the technician until the accountant receives it.
enum CustodyStatus {
  HELD
  RECEIVED
  /// The collection was corrected (no longer cash, or zero) before it was handed over.
  VOID
}

enum ProductCategory {
  SMART_LOCK
  SMART_HOME
  CCTV
  INTERCOM
  OTHER
}

/// What the visit is for (Aura: معاينة / تركيب / تكملة / برمجة / صيانة).
enum VisitType {
  INSPECTION
  INSTALLATION
  COMPLETION
  PROGRAMMING
  MAINTENANCE
}

/// Whether the customer has confirmed the booked time.
enum CustomerConfirmation {
  PENDING
  CONFIRMED
  RESCHEDULE_REQUESTED
  UNREACHABLE
}

/// Why a technician is unavailable on a day (Aura's leave/sick/absence).
enum LeaveType {
  LEAVE
  SICK
  ABSENCE
}

enum LeaveStatus {
  REQUESTED
  APPROVED
  REJECTED
  CANCELLED
}

/// Semantic meaning of a (configurable) appointment status. Used for dashboard counts and
/// reports so admins can rename or add statuses without breaking the statistics.
enum StatusKind {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  POSTPONED
  CANCELLED
  UNABLE_TO_COMPLETE
  /// The visit happened but the job needs another visit (follow-up).
  NEEDS_REVISIT
}

model User {
  id                String    @id @default(cuid())
  name              String
  /// Stored lower-cased; used as the login identifier.
  email             String    @unique
  phone             String?
  role              Role
  isActive          Boolean   @default(true)
  /// bcrypt hash. Null until the user sets a password through an invitation link.
  passwordHash      String?
  /// Calendar colour (hex, e.g. #E55823). Used for Sales employees; kept if the role changes so
  /// historical appointments keep their colour.
  color             String?
  /// Fine-grained permissions that only apply to the VIEWER role (see src/lib/permissions.ts).
  viewerPermissions String[]  @default([])
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)
  passwordChangedAt DateTime? @db.Timestamptz(3)
  /// Interface language chosen by the user ("ar" or "en"); null = not chosen yet (Arabic).
  locale            String?

  sessions              Session[]
  passwordTokens        PasswordToken[]         @relation("TokenUser")
  issuedTokens          PasswordToken[]         @relation("TokenIssuer")
  createdAppointments   Appointment[]           @relation("AppointmentCreator")
  updatedAppointments   Appointment[]           @relation("AppointmentUpdater")
  reportedAppointments  Appointment[]           @relation("AppointmentReporter")
  collectedAppointments Appointment[]           @relation("AppointmentCollector")
  cashHeld              CashCustody[]           @relation("CustodyTechnician")
  cashReceived          CashCustody[]           @relation("CustodyReceiver")
  stockHeld             StockItem[]             @relation("StockHolder")
  stockRegistered       StockItem[]             @relation("StockCreator")
  stockMovesMade        StockMovement[]         @relation("StockActor")
  stockMovesReceived    StockMovement[]         @relation("StockMoveHolder")
  leaves                TechnicianLeave[]       @relation("LeaveUser")
  leavesRequested       TechnicianLeave[]       @relation("LeaveRequester")
  leavesDecided         TechnicianLeave[]       @relation("LeaveDecider")
  assignments           AppointmentTechnician[] @relation("AssignmentTechnician")
  assignedByMe          AppointmentTechnician[] @relation("AssignmentAssigner")
  auditLogs             AuditLog[]
  notifications         Notification[]
  settingsUpdated       Setting[]

  @@index([role, isActive])
  @@map("users")
}

model Session {
  /// SHA-256 of the random token stored in the browser cookie. The raw token is never stored.
  id         String   @id
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  lastSeenAt DateTime @default(now()) @db.Timestamptz(3)
  userAgent  String?
  ipAddress  String?

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// One-time links used for account invitations and admin-initiated password resets.
model PasswordToken {
  id          String    @id @default(cuid())
  /// SHA-256 of the token in the link.
  tokenHash   String    @unique
  userId      String
  user        User      @relation("TokenUser", fields: [userId], references: [id], onDelete: Cascade)
  purpose     String // "INVITE" | "RESET"
  expiresAt   DateTime  @db.Timestamptz(3)
  usedAt      DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  createdById String?
  createdBy   User?     @relation("TokenIssuer", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("password_tokens")
}

/// Records login attempts for rate limiting (works across multiple app instances).
model LoginAttempt {
  id        BigInt   @id @default(autoincrement())
  email     String
  ipAddress String
  success   Boolean
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
  @@map("login_attempts")
}

model Customer {
  id                   String   @id @default(cuid())
  name                 String
  phone                String
  /// Digits only, used for searching and for matching repeat customers.
  phoneDigits          String
  secondaryPhone       String?
  secondaryPhoneDigits String?
  createdAt            DateTime @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @db.Timestamptz(3)

  locations    CustomerLocation[]
  appointments Appointment[]

  @@index([phoneDigits])
  @@index([secondaryPhoneDigits])
  @@index([name])
  @@index([updatedAt])
  /// Trigram indexes make "contains" searches (ILIKE '%...%') use an index (needs pg_trgm).
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "customers_name_trgm_idx")
  @@index([phoneDigits(ops: raw("gin_trgm_ops"))], type: Gin, map: "customers_phoneDigits_trgm_idx")
  @@index([secondaryPhoneDigits(ops: raw("gin_trgm_ops"))], type: Gin, map: "customers_secondaryPhoneDigits_trgm_idx")
  @@map("customers")
}

/// An installation site belonging to a customer. A repeat customer can have several sites
/// (home, office, ...) and many appointments per site.
model CustomerLocation {
  id                 String   @id @default(cuid())
  customerId         String
  customer           Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  label              String?
  area               String?
  streetAddress      String?
  building           String?
  apartment          String?
  floor              String?
  accessInstructions String?
  /// Map link exactly as entered by the user (validated as http/https).
  mapUrl             String?
  latitude           Decimal? @db.Decimal(9, 6)
  longitude          Decimal? @db.Decimal(9, 6)
  createdAt          DateTime @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @db.Timestamptz(3)

  appointments Appointment[]

  @@index([customerId])
  @@index([area])
  @@index([building])
  @@index([area(ops: raw("gin_trgm_ops"))], type: Gin, map: "customer_locations_area_trgm_idx")
  @@index([building(ops: raw("gin_trgm_ops"))], type: Gin, map: "customer_locations_building_trgm_idx")
  @@index([streetAddress(ops: raw("gin_trgm_ops"))], type: Gin, map: "customer_locations_streetAddress_trgm_idx")
  @@map("customer_locations")
}

model AppointmentStatus {
  id             String     @id @default(cuid())
  name           String     @unique
  /// Arabic name shown in the Arabic interface (falls back to `name`).
  nameAr         String?
  kind           StatusKind
  /// Hex colour for status badges.
  color          String
  /// Whether appointments in this status occupy the assigned technicians' time.
  blocksSchedule Boolean    @default(true)
  /// Status given to newly created appointments (exactly one should be true).
  isDefault      Boolean    @default(false)
  isActive       Boolean    @default(true)
  sortOrder      Int        @default(0)
  createdAt      DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime   @updatedAt @db.Timestamptz(3)

  appointments Appointment[]

  @@map("appointment_statuses")
}

model Appointment {
  id         String           @id @default(cuid())
  /// Sequential number used for the human-readable ID (e.g. APT-000123).
  number     Int              @unique @default(autoincrement())
  customerId String
  customer   Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  locationId String
  location   CustomerLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)

  productCategory      ProductCategory
  /// Null for appointments booked before visit types existed.
  visitType            VisitType?
  customerConfirmation CustomerConfirmation @default(PENDING)
  /// The earlier visit this one continues (a repeat / follow-up visit).
  followUpOfId         String?
  followUpOf           Appointment?         @relation("FollowUp", fields: [followUpOfId], references: [id], onDelete: Restrict)
  followUps            Appointment[]        @relation("FollowUp")
  /// Free-text category when productCategory = OTHER.
  categoryOther        String?
  brand                String?
  model                String?
  description          String?
  requiredEquipment    String?
  additionalNotes      String?
  /// Visible only to roles allowed to see internal notes.
  internalNotes        String?
  /// What the technician did / found, written when recording the outcome of the visit.
  visitReport          String?
  reportedAt           DateTime?            @db.Timestamptz(3)
  reportedById         String?
  reportedBy           User?                @relation("AppointmentReporter", fields: [reportedById], references: [id], onDelete: Restrict)

  /// Price agreed with the customer (EGP). Null when not recorded.
  totalPrice      Decimal?        @db.Decimal(12, 2)
  depositAmount   Decimal?        @db.Decimal(12, 2)
  depositMethod   PaymentMethod?
  /// Charged on top of the price, e.g. for a repeat visit the customer caused.
  extraFee        Decimal?        @db.Decimal(12, 2)
  /// Collected from the customer at the visit, recorded with the visit outcome.
  collectedAmount Decimal?        @db.Decimal(12, 2)
  collectedMethod PaymentMethod?
  collectedAt     DateTime?       @db.Timestamptz(3)
  collectedById   String?
  collectedBy     User?           @relation("AppointmentCollector", fields: [collectedById], references: [id], onDelete: Restrict)
  custody         CashCustody?
  stockItems      StockItem[]
  stockMovements  StockMovement[]

  startsAt        DateTime @db.Timestamptz(3)
  endsAt          DateTime @db.Timestamptz(3)
  durationMinutes Int

  statusId String
  status   AppointmentStatus @relation(fields: [statusId], references: [id], onDelete: Restrict)

  /// The Sales employee who originally created the appointment. Never changes; determines the
  /// appointment colour.
  createdById String
  createdBy   User    @relation("AppointmentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById String?
  updatedBy   User?   @relation("AppointmentUpdater", fields: [updatedById], references: [id], onDelete: Restrict)

  /// Client-generated id that makes "create" idempotent (double clicks / retries).
  clientRequestId String? @unique
  /// Optimistic-locking counter; incremented on every update.
  version         Int     @default(1)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  technicians   AppointmentTechnician[]
  auditLogs     AuditLog[]
  notifications Notification[]

  @@index([startsAt])
  @@index([endsAt])
  @@index([statusId, startsAt])
  @@index([createdById, startsAt])
  @@index([customerId])
  @@index([locationId])
  @@index([productCategory])
  @@index([followUpOfId])
  @@map("appointments")
}

/// Technician assignment. startsAt/endsAt/blocksSchedule are copies of the appointment's values,
/// kept in sync by the service layer, so that PostgreSQL can enforce "no overlapping active
/// assignments per technician" with an exclusion constraint.
model AppointmentTechnician {
  appointmentId  String
  appointment    Appointment @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  technicianId   String
  technician     User        @relation("AssignmentTechnician", fields: [technicianId], references: [id], onDelete: Restrict)
  startsAt       DateTime    @db.Timestamptz(3)
  endsAt         DateTime    @db.Timestamptz(3)
  blocksSchedule Boolean
  assignedAt     DateTime    @default(now()) @db.Timestamptz(3)
  assignedById   String?
  assignedBy     User?       @relation("AssignmentAssigner", fields: [assignedById], references: [id], onDelete: Restrict)

  @@id([appointmentId, technicianId])
  @@index([technicianId, startsAt])
  @@map("appointment_technicians")
}

model AuditLog {
  id            String       @id @default(cuid())
  /// APPOINTMENT | USER | STATUS | SETTINGS | CUSTOMER
  entityType    String
  entityId      String
  /// e.g. APPOINTMENT_CREATED, APPOINTMENT_RESCHEDULED, USER_ROLE_CHANGED ...
  action        String
  summary       String
  /// { key, params }: the summary as a message key, shown in each reader's language. Null on rows
  /// written before localization (their `summary` text is shown).
  summaryData   Json?
  /// { field: { from, to } } for updates, or a snapshot for creations.
  changes       Json?
  actorId       String?
  actor         User?        @relation(fields: [actorId], references: [id], onDelete: Restrict)
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)

  @@index([entityType, entityId, createdAt])
  @@index([appointmentId, createdAt])
  @@index([actorId, createdAt])
  @@index([createdAt])
  @@index([summary(ops: raw("gin_trgm_ops"))], type: Gin, map: "audit_logs_summary_trgm_idx")
  @@map("audit_logs")
}

model Notification {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  type          String
  /// English text (kept for rows written before localization and as a fallback).
  message       String
  /// { key, params }: shown in the reader's language.
  data          Json?
  readAt        DateTime?    @db.Timestamptz(3)
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

/// Key/value system settings (timezone, working hours, role options ...).
model Setting {
  key         String   @id
  value       Json
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  updatedById String?
  updatedBy   User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("settings")
}

/// A day range (company-local dates, inclusive) on which a technician cannot be booked once approved.
/// Technicians request it; Admins approve, reject or add it directly.
model TechnicianLeave {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation("LeaveUser", fields: [userId], references: [id], onDelete: Restrict)
  startDate     DateTime    @db.Date
  endDate       DateTime    @db.Date
  type          LeaveType
  reason        String?
  status        LeaveStatus @default(REQUESTED)
  requestedById String
  requestedBy   User        @relation("LeaveRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  decidedById   String?
  decidedBy     User?       @relation("LeaveDecider", fields: [decidedById], references: [id], onDelete: Restrict)
  decidedAt     DateTime?   @db.Timestamptz(3)
  decisionNote  String?
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime    @updatedAt @db.Timestamptz(3)

  @@index([userId, startDate])
  @@index([status, startDate])
  @@map("technician_leaves")
}

/// One row per appointment whose collection was cash: who holds it, and when the accountant got it.
model CashCustody {
  id            String        @id @default(cuid())
  appointmentId String        @unique
  appointment   Appointment   @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  technicianId  String
  technician    User          @relation("CustodyTechnician", fields: [technicianId], references: [id], onDelete: Restrict)
  amount        Decimal       @db.Decimal(12, 2)
  status        CustodyStatus @default(HELD)
  collectedAt   DateTime      @db.Timestamptz(3)
  receivedById  String?
  receivedBy    User?         @relation("CustodyReceiver", fields: [receivedById], references: [id], onDelete: Restrict)
  receivedAt    DateTime?     @db.Timestamptz(3)
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @db.Timestamptz(3)

  @@index([technicianId, status])
  @@index([status, collectedAt])
  @@map("cash_custody")
}

/// A product model kept in stock, with its warranty (Aura's «models» list: "model | months").
model ProductModel {
  id             String          @id @default(cuid())
  /// Unique, compared case-insensitively by the application.
  name           String          @unique
  category       ProductCategory
  warrantyMonths Int             @default(12)
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(3)
  items          StockItem[]

  @@map("product_models")
}

/// One physical item identified by its serial number.
model StockItem {
  id            String          @id @default(cuid())
  /// Stored trimmed, without spaces, upper-case.
  serial        String          @unique
  modelId       String
  model         ProductModel    @relation(fields: [modelId], references: [id], onDelete: Restrict)
  status        StockStatus     @default(IN_STORE)
  /// The technician holding it (status WITH_TECHNICIAN).
  holderId      String?
  holder        User?           @relation("StockHolder", fields: [holderId], references: [id], onDelete: Restrict)
  /// The visit it was installed on (status INSTALLED).
  appointmentId String?
  appointment   Appointment?    @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  installedAt   DateTime?       @db.Timestamptz(3)
  warrantyUntil DateTime?       @db.Date
  note          String?
  createdById   String
  createdBy     User            @relation("StockCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt     DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @db.Timestamptz(3)
  movements     StockMovement[]

  @@index([status, modelId])
  @@index([holderId, status])
  @@index([appointmentId])
  @@map("stock_items")
}

/// Append-only history of every stock change.
model StockMovement {
  id            String       @id @default(cuid())
  itemId        String
  item          StockItem    @relation(fields: [itemId], references: [id], onDelete: Restrict)
  fromStatus    StockStatus?
  toStatus      StockStatus
  holderId      String?
  holder        User?        @relation("StockMoveHolder", fields: [holderId], references: [id], onDelete: Restrict)
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  note          String?
  actorId       String
  actor         User         @relation("StockActor", fields: [actorId], references: [id], onDelete: Restrict)
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)

  @@index([itemId, createdAt])
  @@map("stock_movements")
}
